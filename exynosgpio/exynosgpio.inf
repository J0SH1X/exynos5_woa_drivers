; Exynos5420 GPIO interrupt lines (GPD1, GPX3) for v1awifi, Windows RT 8.1.
;
;   dism /Image:<mount> /Add-Driver /Driver:exynosgpio.inf /ForceUnsigned

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
DriverVer   = 10/31/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
exynosgpio.sys = 1

[Manufacturer]
%Mfg% = Devices, NTARM

[Devices.NTARM]
%DeviceDesc% = Install, ACPI\EXYN5003

[Install.NT]
CopyFiles = Files

[Files]
exynosgpio.sys

[Install.NT.Services]
AddService = exynosgpio, 0x00000002, Service

[Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %12%\exynosgpio.sys

[Install.NT.Wdf]
KmdfService = exynosgpio, Wdf

[Wdf]
KmdfLibraryVersion = 1.13

[Strings]
Provider   = "Exynos5420"
Mfg        = "Samsung"
Disk       = "Exynos5420 drivers"
DeviceDesc = "Exynos5 GPIO controller"
