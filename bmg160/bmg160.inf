; Bosch BMG160 gyroscope (v1awifi, SM-P900), Windows RT 8.1.
;
; mshidkmdf.sys is the function driver (HID class); bmg160.sys is its lower
; filter: it talks to the chip over SPB (exynosi2c, I2C3) and presents a HID
; sensor collection, which Windows' HID sensor class driver
; (sensorshidclassdriver.inf) binds.

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Provider%
DriverVer   = 11/02/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
bmg160.sys = 1

[Manufacturer]
%Mfg% = Devices, NTARM

[Devices.NTARM]
%DeviceDesc% = Install, ACPI\EXYN500D

[Install.NT]
CopyFiles = Files

[Files]
bmg160.sys

[Install.NT.HW]
AddReg = Filter_AddReg

[Filter_AddReg]
HKR,,"LowerFilters",0x00010008,"bmg160"

[Install.NT.Services]
AddService = bmg160, , Filter_Service
AddService = mshidkmdf, 0x00000002, mshidkmdf_Service

[Filter_Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %12%\bmg160.sys

[mshidkmdf_Service]
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\mshidkmdf.sys

[Install.NT.Wdf]
KmdfService = bmg160, Wdf

[Wdf]
KmdfLibraryVersion = 1.13

[Strings]
Provider   = "Exynos5420"
Mfg        = "Bosch Sensortec"
Disk       = "Exynos5420 drivers"
DeviceDesc = "Bosch BMG160 gyroscope"
