; Exynos5420 UART (v1awifi, SM-P900), Windows RT 8.1:
; EXYN5011 UART0 (SerCx2, PIO + PL330 system DMA): the Broadcom Bluetooth transport.
;
;   dism /Image:<mount> /Add-Driver /Driver:exynosuart.inf /ForceUnsigned

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
DriverVer   = 10/31/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
exynosuart.sys = 1

[Manufacturer]
%Mfg% = Devices, NTARM

[Devices.NTARM]
%DeviceDesc% = Install, ACPI\EXYN5011

[Install.NT]
CopyFiles = Files

[Files]
exynosuart.sys

[Install.NT.Services]
AddService = exynosuart, 0x00000002, Service

[Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %12%\exynosuart.sys

[Install.NT.Wdf]
KmdfService = exynosuart, Wdf

[Wdf]
KmdfLibraryVersion = 1.13

[Strings]
Provider   = "Exynos5420"
Mfg        = "Samsung"
Disk       = "Exynos5420 drivers"
DeviceDesc = "Exynos5 UART controller (UART0, Bluetooth)"
