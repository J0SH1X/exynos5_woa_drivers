; Wacom G9PLL S Pen digitizer (v1awifi, SM-P900), Windows RT 8.1.
;
; mshidkmdf.sys is the function driver (HID class); wacomg9.sys is its lower
; filter and talks to the controller over SPB (exynosi2c) with its interrupt
; on a GpioInt (exynosgpio).
;
;   dism /Image:<mount> /Add-Driver /Driver:wacomg9.inf /ForceUnsigned

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Provider%
DriverVer   = 10/31/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
wacomg9.sys = 1

[Manufacturer]
%Mfg% = Devices, NTARM

[Devices.NTARM]
%DeviceDesc% = Install, ACPI\EXYN5006

[Install.NT]
CopyFiles = Files

[Files]
wacomg9.sys

[Install.NT.HW]
AddReg = Filter_AddReg

[Filter_AddReg]
HKR,,"LowerFilters",0x00010008,"wacomg9"

[Install.NT.Services]
AddService = wacomg9, , Filter_Service
AddService = mshidkmdf, 0x00000002, mshidkmdf_Service

[Filter_Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %12%\wacomg9.sys

[mshidkmdf_Service]
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\mshidkmdf.sys

[Install.NT.Wdf]
KmdfService = wacomg9, Wdf

[Wdf]
KmdfLibraryVersion = 1.13

[Strings]
Provider   = "Exynos5420"
Mfg        = "Wacom"
Disk       = "Exynos5420 drivers"
DeviceDesc = "Wacom G9PLL S Pen digitizer"
